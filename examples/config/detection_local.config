# Sample infrapy config file for beamforming-based detection
#
# Example uses:
# infrapy run_fk --cnfg-file config/detection_local.config --cpu-cnt 10


[DATA IO]
local_wvfrms = data/YJ.BRP*.SAC
det_label = BRP_hf

[FK]
freq_min = 2.0
freq_max = 8.0
window_len = 4.0
window_step = 2.0

[FD]
p_value = 0.02
min_duration = 20.0
merge_dets = True





