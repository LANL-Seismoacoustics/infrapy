# Sample infrapy config file for updated CLI and DB interface
#
# Example uses:
# infrapy run_assoc --cnfg-file config/assoc_example.config --cpu-cnt 10

[DATA IO]
det_label = data/detection_set1.json
ev_label = assoc_out

[ASSOC]
range_max = 2000.0
back_az_width = 10.0
distance_matrix_max = 8.0
cluster_linkage = weighted
cluster_threshold = 4.0
trimming_threshold = 3.8
ev_population_min = 3
ev_station_min = 2
