# InfraPy beamforming detection file for 1.0 - 4.0 Hz frequency band
# Window length is tuned to tuned to capture 6 cycles and have 33% overlap

[FK]
freq_min = 1.0
freq_max = 4.0
window_len = 6
window_step = 2
cpu_cnt = 12

[FD]
window_len = 3600
p_value = 0.01
min_duration = 20.0
back_az_width = 20.0
merge_dets = True

