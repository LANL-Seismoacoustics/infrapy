# Default parameter values for running analysis algorithms
# Note: data I/O methods have no default values
[GENERAL]
version=1

[FK]
freq_min = 0.5
freq_max = 5.0
back_az_min = -180.0
back_az_max = 180.0
back_az_step = 2.0
trace_vel_min = 300.0
trace_vel_max = 600.0
trace_vel_step = 2.5
method = bartlett
signal_start = None
signal_end = None
noise_start = None
noise_end = None
window_len = 10
sub_window_len = None
window_step = 5
cpu_cnt = None 

[FD]
window_len = 3600
p_value = 0.01
min_duration = 10
back_az_width = 15.0
fixed_thresh = None
thresh_ceil = None
return_thresh = False
merge_dets = False

[SD]
