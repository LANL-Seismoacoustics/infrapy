range_max = 2000.0
resolution = 180
distance_matrix_max = 8.0
cluster_linkage = weighted
cluster_threshold = 5.0
trimming_threshold = 3.8
event_population_min = 3
event_station_min = 2
multithread = False
cpu_cnt = None

[LOC]
