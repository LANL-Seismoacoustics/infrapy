morlet_omega0 = 12.0
p_value = 0.01
freq_min = 1.0
freq_max = 20.0
window_len = 900.0
window_step = 450.0
freq_tm_factor = 35.0
cluster_eps = 10.0
cluster_min_samples = 40
cluster_window_len = 600.0

[SD-CWT]
